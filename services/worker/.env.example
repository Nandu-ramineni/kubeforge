HEALTH_PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://kubeforge:kubeforge@localhost:5432/kubeforge
# See services/api/.env.example - same reasoning, must stay false locally.
DB_SSL=false

REDIS_URL=redis://localhost:6379

# Same managed broker as the API - both services must point at the same
# RabbitMQ instance and queue to actually talk to each other.
RABBITMQ_URL=amqps://<user>:<password>@<your-broker-host>/<vhost>
TASK_QUEUE_NAME=tasks.process
QUEUE_PREFETCH=5
