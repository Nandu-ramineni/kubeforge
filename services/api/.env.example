PORT=3000
LOG_LEVEL=info

# Either set DATABASE_URL directly, or the individual PG* vars below
DATABASE_URL=postgres://kubeforge:kubeforge@localhost:5432/kubeforge
# true only when DATABASE_URL points at real RDS (which enforces SSL) - a
# local Postgres container has no TLS listener and this must stay false.
DB_SSL=false

REDIS_URL=redis://localhost:6379
TASK_CACHE_TTL_SECONDS=30

# RabbitMQ is a managed cloud broker, not a local container - there is no
# localhost default and the app will refuse to start without this.
# Amazon MQ for RabbitMQ (AWS-native, fits the Terraform phase):
#   RABBITMQ_URL=amqps://<user>:<password>@<broker-id>.mq.<region>.amazonaws.com:5671
# CloudAMQP (fastest to spin up a free instance for local dev):
#   RABBITMQ_URL=amqps://<user>:<password>@<instance>.cloudamqp.com/<vhost>
RABBITMQ_URL=amqps://<user>:<password>@<your-broker-host>/<vhost>
TASK_QUEUE_NAME=tasks.process
